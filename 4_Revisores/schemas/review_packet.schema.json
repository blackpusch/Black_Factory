{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackfactory.local/schemas/review_packet.schema.json",
  "title": "Black Factory ReviewPacket v1.0",
  "description": "Clean-context isolated input packet generated by 4_Revisores (reviewer.exe prepare) from a DeliveryBundle v1.0 for a single reviewer lens. git.diff_rel_path resolves inside 4_Revisores/runtime/; ui_evidence_refs resolve inside <task_id>/<bundle_id>/ (ui_evidence/<relPath>).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "created_at",
    "trace_id",
    "task_id",
    "chunk_id",
    "gengis_attempt",
    "reset_epoch",
    "bounce_cycle",
    "bundle_id",
    "bundle_sha256",
    "builder_model_family",
    "axis",
    "applicability",
    "target_model",
    "git",
    "scope",
    "brain_context",
    "tdd_evidence",
    "previous_bounces",
    "ui_live_surface",
    "ui_evidence_refs",
    "checklist"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^PKT-[0-9a-f]{16}-(security|code_architecture|ux|ui)$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "gengis_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "reset_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "bounce_cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^BND-[a-z0-9][a-z0-9_-]{2,63}-.+?-a[1-9][0-9]*-r[0-9]+-c[0-3]$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_model_family": {
      "type": "string",
      "minLength": 1
    },
    "axis": {
      "type": "string",
      "enum": [
        "security",
        "code_architecture",
        "ux",
        "ui"
      ]
    },
    "applicability": {
      "$ref": "#/$defs/axis_applicability"
    },
    "target_model": {
      "$ref": "#/$defs/target_model_policy"
    },
    "git": {
      "$ref": "#/$defs/git_packet_info"
    },
    "scope": {
      "$ref": "#/$defs/scope_info"
    },
    "brain_context": {
      "$ref": "#/$defs/packet_brain_info"
    },
    "tdd_evidence": {
      "$ref": "#/$defs/tdd_evidence"
    },
    "previous_bounces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ui_live_surface": {
      "type": "boolean"
    },
    "ui_evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "axis_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "mode",
        "reason",
        "profile_role"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "always",
            "auto",
            "included"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "profile_role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptual_reference",
        "required_model_family",
        "disallowed_model_families",
        "clean_context_required"
      ],
      "properties": {
        "conceptual_reference": {
          "type": "string",
          "minLength": 1
        },
        "required_model_family": {
          "type": "string",
          "minLength": 1
        },
        "disallowed_model_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clean_context_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "changed_file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "mode",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ]
        },
        "mode": {
          "type": "string",
          "pattern": "^(0644|0755|0000)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|DELETED)$"
        }
      }
    },
    "git_packet_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_branch",
        "build_branch",
        "base_ref",
        "worktree_tree_sha256",
        "changed_files",
        "diff_rel_path",
        "diff_sha256",
        "diff_bytes"
      ],
      "properties": {
        "target_branch": {
          "type": "string"
        },
        "build_branch": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/changed_file_entry"
          }
        },
        "diff_rel_path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative to 4_Revisores/runtime/ (isolated copy <task_id>/<bundle_id>/bundle.diff)."
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        }
      }
    },
    "scope_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_modify",
        "read_only",
        "forbidden"
      ],
      "properties": {
        "can_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "brain_doc_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rel_path",
        "type",
        "status",
        "verified_head"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "rel_path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "verified_head": {
          "type": "string"
        }
      }
    },
    "risk_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "level",
        "matched_paths",
        "mandatory_gate"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "matched_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory_gate": {
          "type": "string"
        }
      }
    },
    "packet_brain_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brain_db_mtime",
        "risk_zones_sha256",
        "highest_risk_level",
        "matched_docs",
        "risk_hits"
      ],
      "properties": {
        "brain_db_mtime": {
          "type": "string"
        },
        "risk_zones_sha256": {
          "type": "string"
        },
        "highest_risk_level": {
          "type": "string",
          "enum": [
            "NONE",
            "BAJO",
            "MEDIO",
            "ALTO",
            "CRITICO"
          ]
        },
        "matched_docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/brain_doc_summary"
          }
        },
        "risk_hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk_hit"
          }
        }
      }
    },
    "red_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "gengis_attempt",
        "bounce_cycle",
        "inherited_from_cycle",
        "cmd_index",
        "command",
        "exit_code",
        "duration_ms",
        "output_excerpt",
        "truncated",
        "red_worktree_tree_sha256",
        "has_test_file",
        "recorded_at"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "gengis_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "bounce_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "inherited_from_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "cmd_index": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output_excerpt": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "red_worktree_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "has_test_file": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "command_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmd_index",
        "command",
        "exit_code",
        "duration_ms",
        "output_excerpt",
        "truncated"
      ],
      "properties": {
        "cmd_index": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "const": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output_excerpt": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "tdd_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "green"
      ],
      "properties": {
        "red": {
          "$ref": "#/$defs/red_evidence"
        },
        "green": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command_evidence"
          }
        }
      }
    }
  }
}
