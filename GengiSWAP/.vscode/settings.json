{
  "todo-tree.general.tags": [
    "[ ]",
    "[~]",
    "[x]",
    "[-]",
    "[!]"
  ],
  "todo-tree.highlights.customHighlight": {
    "[ ]": {
      "icon": "circle",
      "type": "tag",
      "foreground": "#ffffff",
      "background": "#6e7681",
      "iconColour": "#8b949e"
    },
    "[~]": {
      "icon": "clock",
      "type": "tag",
